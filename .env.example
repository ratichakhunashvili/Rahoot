# Copy this file to .env and fill in real values. .env is gitignored.

# Supabase Postgres connection strings (Project Settings -> Database). Names
# match what the Vercel Supabase Marketplace integration injects automatically.
# POSTGRES_PRISMA_URL is the pooled connection string (used at runtime).
# POSTGRES_URL_NON_POOLING is the direct one (used by `prisma migrate`).
POSTGRES_PRISMA_URL="postgres://postgres.[project-ref]:[password]@[region].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgres://postgres.[project-ref]:[password]@[region].pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase API settings (Project Settings -> API). Live-mode gameplay is
# synced over a Supabase Realtime broadcast channel instead of a custom
# WebSocket server - see src/lib/live-game.ts / realtime-server.ts /
# realtime-client.ts. SUPABASE_SERVICE_ROLE_KEY is server-only secret -
# never expose it to the browser (no NEXT_PUBLIC_ prefix, on purpose).
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="change-me"
SUPABASE_SERVICE_ROLE_KEY="change-me"

# Only these credentials can log in to /admin - change the password before deploying.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Random secret used to sign the session cookie. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="change-this-to-a-long-random-string"

# Public URL students' phones will hit when they scan the QR code.
# Must be reachable from their network - e.g. your Vercel production URL.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
