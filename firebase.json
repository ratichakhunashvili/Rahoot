{
  "hosting": {
    "public": "firebase-public",
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "rahoot",
          "region": "europe-west1"
        }
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, max-age=0, must-revalidate"
          }
        ]
      }
    ]
  }
}
